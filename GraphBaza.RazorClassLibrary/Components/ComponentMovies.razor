@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
<div class="movie-container">
     <div class="header-container">
        <h1>🍿 BAZA POP 🍿</h1>
        <p class="text-muted">New releases for 2025</p>
        <ComponentSearch OnSearch="HandleSearch" />
    </div>
    @if (movies == null)
    {
        <p class="loading-text"><em>Loading...</em></p>
    }
    else
    {
        <div class="movie-grid">
            @foreach (var movie in filteredMovies)
            {
	    <div class="movie-card">
		<div class="movie-poster-container">
		    <img src="@movie.PosterUrl" class="movie-poster" alt="@movie.Title poster">
		    <div class="poster-overlay">
			<div class="movie-title">@movie.Synopsis</div>
			<span class="genre-emoji">
				<i class="fas fa-film genre-emoji"></i>
                        </span>
			    <small class="text-muted-release">@movie.ReleaseDate.ToString("MMM dd, yyyy")</small>
			</div>
		    </div>
		</div>
		}
	    </div>
	}
    </div>

    @code {
	private MovieType[]? movies;
	private MovieType[]? filteredMovies;
	//private string searchTerm = string.Empty;
	protected override async Task OnInitializedAsync()
	{
	    await Task.Delay(500);

	    var startDate = DateTime.Now.AddDays(Random.Shared.Next(1,15));
	    movies = Enumerable.Range(1, 12).Select(index => new MovieType {
		Title = $"Movie {index}",
		ReleaseDate = startDate.AddMonths(index).AddDays(Random.Shared.Next(1,28)),
		Genre = (Genre)Random.Shared.Next(0, 5),
		Synopsis = GenerateSynopsis(),
            PosterUrl = GetRandomImageUrl()
        }).ToArray();
        
        filteredMovies = movies;
    }

    private string GetGenreEmoji(Genre genre)
    {
        return genre switch {
            Genre.Drama => "🎭",
            Genre.Horror => "👻",
            Genre.Documentary => "📽",
            Genre.SciFi => "🦸",
            Genre.Action => "🎬",
            _ => "🎬"
        };
    }

    private string GenerateSynopsis()
    {
        var summariesStart = new[] {"The incredible adventure of", "The untold story of", "A journey with", 
                                   "The most amazing tale about", "Nothing is what it seems in"};
        var summariesEnd = new[] { "the president's wife", "a formula 1 champion", "a sentient toy car", 
                                  "a pop star turned spy", "a group of rogue scientists"};
        return $"{summariesStart[Random.Shared.Next(summariesStart.Length)]} " +
               $"{summariesEnd[Random.Shared.Next(summariesEnd.Length)]}";
    }

    private string GetRandomImageUrl()
    {
        var images = new[] {
	    "https://upload.wikimedia.org/wikipedia/en/c/c1/The_Matrix_Poster.jpg",
	    "https://upload.wikimedia.org/wikipedia/en/2/24/Twisters_Official_US_Theatrical_Poster.jpg",
	    "https://upload.wikimedia.org/wikipedia/en/6/6e/Jurassic_World_poster.jpg",
	    "https://upload.wikimedia.org/wikipedia/en/4/49/Dead_poets_society.jpg",
	    "https://upload.wikimedia.org/wikipedia/en/2/2e/Inception_%282010%29_theatrical_poster.jpg",
        };
        return images[Random.Shared.Next(images.Length)];
    }
    private void HandleSearch(string term)
    {
        string searchTerm = term?.Trim() ?? string.Empty;

        if (movies != null)
        {
            filteredMovies = string.IsNullOrEmpty(searchTerm)
                ? movies
                : movies.Where(m => m.Synopsis.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                      .ToArray();

            StateHasChanged();
        }
    }
}