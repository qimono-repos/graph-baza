<EditForm Model="@todo" OnValidSubmit="AddTodo" FormName="TodoForm">
    <div class="mb-3 row g-2 align-items-center">
        <label for="todoItem" class="col-form-label col-3">Search: </label>
	<div class="col-7">
             <InputText @bind-Value="todo.Description" class="form-control" id="todoItem"/>
	</div>
	<div clas="col-1 d-grid">
             <button class="btn btn-primary col-2" type="Submit"> + </button>  
	</div>
    </div>
</EditForm>

<h3>Hallazgos</h3>
<li class="mb-2">
    @foreach(var todo in todos){
        @if(todo.IsComplete){
            <span style="text-decoration: line-through">
                @todo.Description
            </span>
        } else {
            @todo.Description
            <button 
                class="btn btn-warning btn-sm ms-3"
                @onClick="()=> todo.IsComplete = true"
            >Confirmado</button>
        }
    }
</li>

@code {
    private List<TodoModel> todos = new();
    private TodoModel todo = new TodoModel(){Description= string.Empty,};

    private void AddTodo(EditContext context){
        todos.Add(todo);
        todo = new TodoModel(){Description=string.Empty};
    }
}