

@page "/movies"
@attribute [StreamRendering]
@using Component = GraphBaza.RazorClassLibrary.Components

<PageTitle>Movies</PageTitle>

<h1>Movies</h1>

<p>New releases for 2025.</p>

<ComponentSearch OnSearch="HandleSearch" />

@if (movies == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th aria-label="Expected date of release in Max">Release Date</th>
                <th aria-label="Movie classification">Genre</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in filteredMovies)
            {
                <tr>
                    <td>@x.Title</td>
                    <td>@x.ReleaseDate.ToShortDateString()</td>
                    <td>@x.Genre</td>
                    <td>@x.Synopsis</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private MovieType[]? movies;
    private MovieType[]? filteredMovies;
    //private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);

        var startDate = DateTime.Now.AddDays(Random.Shared.Next(1,15));
        var summariesStart = new[] {"The incredible adventure of", "The untold story of", "A jouney with", "The most amazing tale about", "Nothing is what it seems in"};
        var summariesEnd = new[] { " the president's wife", " The formula 1 best driver", " the car toy", " the new pop star", " a group of cientists"};
        movies= Enumerable.Range(1, 5).Select(index => new MovieType{
	    Title = "AAA",
            ReleaseDate = startDate.AddDays(index + 30),
	    Genre = (Genre)Random.Shared.Next(0, Enum.GetValues(typeof(Genre)).Length),
            Synopsis = summariesStart[Random.Shared.Next(summariesStart.Length)] + summariesEnd[Random.Shared.Next(summariesEnd.Length)] 
        }).ToArray();
	filteredMovies= movies;
    }

    private void HandleSearch(string term)
    {
        string searchTerm = term?.Trim() ?? string.Empty;
        
        if (movies != null)
        {
            filteredMovies = string.IsNullOrEmpty(searchTerm)
                ? movies
                : movies.Where(m => m.Synopsis.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                      .ToArray();
            
            StateHasChanged();
        }
    }


}
